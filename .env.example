AGENT_API_KEY=local-demo-key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
NIMBLE_API_KEY=
TIGER_DATABASE_URL=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SENTRY_DSN=

# Optional local AI without credentials
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:1b

# Optional: point the stdio MCP client to a hosted AgentGate account.
# Set AGENTGATE_URL to the HTTPS deployment and AGENTGATE_PERSONAL_TOKEN
# to a personal token created while signed in. Never place tokens in URLs.
AGENTGATE_URL=http://127.0.0.1:4180
AGENTGATE_PERSONAL_TOKEN=

# Seller marketplace uses an empty separate database; key is generated locally if blank.
MARKETPLACE_MODE=1
SELLER_API_KEY=
